{
  "schemaVersion": 1,
  "id": "io.github.seunghan91.ainote-clock",
  "name": "AI Note Clock",
  "version": "0.1.0",
  "author": "seunghan91",
  "license": "MIT",
  "description": "Apple-style date and time with a calendar and your AI Note tasks (Korean/English/Chinese)",
  "kinds": ["bar-widget"],
  "entryPoints": {"barWidget": "BarWidget.qml"},
  "barWidget": {
    "displayName": "AI Note Clock",
    "description": "Apple-style date and time with a calendar and your AI Note tasks (Korean/English/Chinese)",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {"taskIndicator": "none", "panelLayout": "vertical", "weekStart": "sunday", "language": "auto"},
    "schema": [
      {"key": "language", "type": "enum", "label": "Language", "options": ["auto", "en", "ko", "zh-Hans", "zh-Hant"], "defaultValue": "auto"},
      {"key": "taskIndicator", "type": "enum", "label": "Tasks in the bar", "options": ["none", "split", "total"], "defaultValue": "none"},
      {"key": "panelLayout", "type": "enum", "label": "Calendar layout", "options": ["vertical", "horizontal"], "defaultValue": "vertical"},
      {"key": "weekStart", "type": "enum", "label": "Week starts on", "options": ["sunday", "monday"], "defaultValue": "sunday"}
    ]
  },
  "omarchy": {"clonedFrom": "omarchy.clock"}
}
